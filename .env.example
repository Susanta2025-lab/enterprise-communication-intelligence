APP_NAME=Enterprise Communication Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
AI_PROVIDER=mock

# Required only when AI_PROVIDER=microsoft_foundry
FOUNDRY_PROJECT_ENDPOINT=https://eci-foundry-dev-susanta.services.ai.azure.com/api/projects/eci-project-dev
FOUNDRY_MODEL_DEPLOYMENT=eci-gpt-54-mini

# Required only when AI_PROVIDER=amazon_bedrock
# AI_PROVIDER=amazon_bedrock
# BEDROCK_REGION=eu-south-2
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Application-user authentication (Client → ECI API).
# Development may use AUTH_MODE=disabled.
# Production MUST use AUTH_MODE=oidc with issuer, audience, and JWKS URL.
# Placeholders below are not a real identity provider.
AUTH_MODE=disabled
OIDC_ISSUER=https://example.invalid/
OIDC_AUDIENCE=eci-api
OIDC_JWKS_URL=https://example.invalid/.well-known/jwks.json
OIDC_REQUIRED_PERMISSION=communications:analyze

# Persistence (Phase 9A). Optional in development: omit DATABASE_URL to keep
# analyze-only startup with no local database file created.
# Production persistence requires PostgreSQL via psycopg:
# DATABASE_URL=postgresql+psycopg://eci:eci@localhost:5432/eci
# The values above are placeholders, not a real database.

# Local/development mailbox credential material (Phase 12B). Optional.
# Ordinary startup, mock AI, and fake execution do not require these variables.
# credential_ref is an opaque locator, not the access token itself.
# Naming: ECI_COMMUNICATION_CREDENTIAL_<PROVIDER>_<NORMALIZED_REF>_ACCESS_TOKEN
# credential_ref allows letters, digits, and hyphens (not underscores).
# Hyphens in credential_ref become underscores in the environment name.
# Example: provider=gmail, credential_ref=demo-account maps to:
# ECI_COMMUNICATION_CREDENTIAL_GMAIL_DEMO_ACCOUNT_ACCESS_TOKEN=
# Example: provider=microsoft_graph, credential_ref=demo-account maps to:
# ECI_COMMUNICATION_CREDENTIAL_MICROSOFT_GRAPH_DEMO_ACCOUNT_ACCESS_TOKEN=
# This is local/dev token injection only. It is not production OAuth,
# token refresh, Azure Key Vault, or AWS Secrets Manager.
