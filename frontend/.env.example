# Public SPA configuration only. Never place client secrets, passwords, or tokens here.
# Copy to frontend/.env for local development. Real External ID SPA registration is an operator step.

VITE_ECI_API_BASE_URL=http://localhost:8000
VITE_ENTRA_AUTHORITY=https://<external-id-subdomain>.ciamlogin.com/<tenant-id>
VITE_ENTRA_SPA_CLIENT_ID=<spa-client-id>
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ECI_API_SCOPES=api://<eci-api-client-id>/communications:read,api://<eci-api-client-id>/communications:analyze,api://<eci-api-client-id>/communications:connect,api://<eci-api-client-id>/communications:workflow,api://<eci-api-client-id>/communications:send

# ---------------------------------------------------------------------------
# Deployment presentation metadata (public build-time only)
# ---------------------------------------------------------------------------
# These values are embedded at Vite build time for the Platform Owner UI badge.
# They are NOT credentials, NOT authorization inputs, NOT runtime cloud discovery,
# and NOT owner-identity inputs. Owner status remains server-authoritative via /api/v1/me.
#
# Allowed combinations (fail closed; no silent fallback):
#   Azure: VITE_ECI_CLOUD_PROVIDER=azure
#          VITE_ECI_AI_PROVIDER=microsoft_foundry
#          VITE_ECI_CLOUD_REGION=Spain Central
#   AWS:   VITE_ECI_CLOUD_PROVIDER=aws
#          VITE_ECI_AI_PROVIDER=amazon_bedrock
#          VITE_ECI_CLOUD_REGION=eu-south-2
#
# Cloud deployment builds (explicit Vite modes — preferred):
#   Azure: npm run build:azure
#          # equivalent: npm run build -- --mode azure
#   AWS:   npm run build:aws
#          # equivalent: npm run build -- --mode aws
#
# Tracked frontend/.env.azure and frontend/.env.aws supply safe presentation
# metadata only (cloud / AI provider / region). Auth, API base URL, SPA client
# id, scopes, and redirect URI remain operator/local or CI/shell supplied.
#
# Operator/local overrides (Git-ignored):
#   .env.azure.local  — Azure-specific local values
#   .env.aws.local    — AWS-specific local values
#
# Do NOT use .env.production.local for cloud-specific deployment settings;
# generic production mode can cross-contaminate Azure and AWS builds.
# Never place credentials or secrets in VITE_* variables.
# Shell/CI environment variables override dotenv values (highest precedence).

VITE_ECI_CLOUD_PROVIDER=azure
VITE_ECI_AI_PROVIDER=microsoft_foundry
VITE_ECI_CLOUD_REGION=Spain Central
